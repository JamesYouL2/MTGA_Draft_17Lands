+    @staticmethod
+    def _three_color(dataset: Dataset) -> Tuple[float, float]:
+        """(share, gap) for decks of three or more colors: their share of the
+        set's games, and their win rate minus two-color decks', in points."""
+        games = {}
+        for card in (dataset.get_card_ratings() or {}).values() if dataset else ():
+            for colors, stats in card.get(DATA_FIELD_DECK_COLORS, {}).items():
+                if colors != "All Decks":
+                    games[colors] = games.get(colors, 0) + (stats.get("game_count") or 0)
+        total = sum(games.values())
+        if not total:
+            return 0.0, -99.0
+        rates = dataset.get_color_ratings() or {}
+
+        def win_rate(groups):
+            rated = [g for g in groups if rates.get(g)]
+            weight = sum(games[g] for g in rated)
+            return sum(rates[g] * games[g] for g in rated) / weight if weight else None
+
+        three = [g for g in games if len(g) >= 3]
+        many, two = win_rate(three), win_rate([g for g in games if len(g) == 2])
+        gap = many - two if many is not None and two is not None else -99.0
+        return sum(games[g] for g in three) / total, gap
 
