+    def _splash_count(self, off_color, lane) -> int:
+        """Most pool playables (rated above mean - 1 SD, not lands) needing any
+        one off-lane color that this card's off-lane cost names."""
+        needed = {c for options in off_color for c in options}
+        counts = {c: 0 for c in needed}
+        for c in self.pool:
+            if "Land" in c.get("types", []):
+                continue
+            wr = float(c.get("deck_colors", {}).get("All Decks", {}).get("gihwr", 0.0))
+            if wr <= self.global_mean - self.global_std:
+                continue
+            theirs = {x for options in off_color_requirements(c, lane) for x in options}
+            for color in needed & theirs:
+                counts[color] += 1
+        return max(counts.values(), default=0)
