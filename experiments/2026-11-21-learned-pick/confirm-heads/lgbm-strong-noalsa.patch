+"""Experiment head only (experiments/2026-11-21-learned-pick): score a pack
+with a learned pick model from Tools/LearnedPick instead of the advisor.
+
+The models are read from $LEARNED_MODELS/<$SET>/, fitted without that set."""
+
+import os
+import sys
+
+_models = {}
+
+
+def rescore(advisor, recommendations, pack_cards, pick, pack, head):
+    tool = os.path.abspath(os.environ.get("LEARNED_PICK_TOOL", "Tools/LearnedPick"))
+    if tool not in sys.path:
+        sys.path.insert(0, tool)
+    import model
+
+    key = (os.environ["SET"], head)
+    if key not in _models:
+        _models[key] = model.load(os.environ["LEARNED_MODELS"], *key)
+    scores = model.score_pack(
+        _models[key],
+        pack_cards,
+        advisor.pool,
+        pack,
+        pick,
+        advisor.global_mean,
+        advisor.global_std,
+    )
+    for r in recommendations:
+        if r.card_name in scores:
+            r.contextual_score = scores[r.card_name]
